<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado enfocado: borde rojo de alto contraste -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ra_light_card" />
            <stroke android:width="2dp" android:color="@color/ra_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Estado en reposo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ra_light_bg" />
            <stroke android:width="1.5dp" android:color="@color/ra_light_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
