<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado seleccionado -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AE53935" />
            <stroke android:width="1.5dp" android:color="@color/ra_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Estado no seleccionado -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ra_light_bg" />
            <stroke android:width="1dp" android:color="@color/ra_light_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
