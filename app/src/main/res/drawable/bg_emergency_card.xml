<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado seleccionado (rojo claro, borde rojo) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FEF2F2" />
            <stroke android:width="2dp" android:color="@color/ra_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Estado normal (blanco, borde gris) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ra_card_bg" />
            <stroke android:width="1dp" android:color="@color/ra_border_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>