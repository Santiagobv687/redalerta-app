<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ra_light_bg"
    tools:context=".ui.auth.VerificarCodigoActivity">

    <!-- ═══════════ TOP BAR institucional oscuro (56dp) ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ra_topbar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_alert_triangle"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/login_brand"
            android:textColor="@color/ra_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvVolverPaso1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:insetTop="6dp"
            android:insetBottom="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/rec_paso2_topbar_volver"
            android:textColor="@color/ra_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#1FE53935"
            app:strokeColor="@color/ra_red"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="16dp"
            app:iconPadding="6dp"
            app:iconTint="@color/ra_red"
            app:rippleColor="#33E53935" />
    </LinearLayout>

    <!-- ═══════════ Contenido scrollable ═══════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ═══ Encabezado ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rec_paso2_titulo"
                android:textColor="@color/ra_light_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/rec_paso2_subtitulo"
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="14sp" />

            <!-- ═══ Bloque Destacado: Correo Ingresado + Opción de Editar ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/ra_light_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ra_light_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.RedAlerta.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rec_paso2_correo_label" />

                        <TextView
                            android:id="@+id/tvCorreoIngresado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="usuario@redalerta.gov.co" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditarCorreo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:text="@string/rec_paso2_btn_editar_correo"
                        android:textColor="@color/ra_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_edit"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/ra_red"
                        app:rippleColor="#1AE53935"
                        app:strokeColor="@color/ra_red"
                        app:strokeWidth="1.2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Card Principal: Entrada de Código de 6 Bloques ═══ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlerta.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="@string/rec_paso2_card_titulo"
                        android:textColor="@color/ra_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/rec_paso2_instruccion_bloques"
                        android:textColor="@color/ra_light_text_secondary"
                        android:textSize="13sp" />

                    <!-- Contenedor de los 6 bloques de dígitos (54dp alto c/u para precisión táctil) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="6">

                        <EditText
                            android:id="@+id/etOtp1"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="4" />

                        <EditText
                            android:id="@+id/etOtp2"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="8" />

                        <EditText
                            android:id="@+id/etOtp3"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="2" />

                        <EditText
                            android:id="@+id/etOtp4"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="9" />

                        <EditText
                            android:id="@+id/etOtp5"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="1" />

                        <EditText
                            android:id="@+id/etOtp6"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/selector_otp_box"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/ra_light_text"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="5" />
                    </LinearLayout>

                    <!-- Mensaje de error dinámico (sin espacio fantasma cuando está oculto) -->
                    <TextView
                        android:id="@+id/tvErrorOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/ra_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Por favor, complete los 6 dígitos del código."
                        tools:visibility="visible" />

                    <!-- Acción primaria: Verificar Código -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerificarCodigo"
                        style="@style/Widget.RedAlerta.Button.Next"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/rec_paso2_btn_verificar" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/ra_light_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:text="@string/rec_paso2_label_no_recibio"
                        android:textColor="@color/ra_light_text_secondary"
                        android:textSize="12sp" />

                    <!-- Acción secundaria con contorno discreto y temporizador: Enviar uno nuevo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReenviarCodigo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/rec_paso2_btn_reenviar"
                        android:textColor="@color/ra_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ra_light_bg"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/ra_light_label"
                        app:rippleColor="#1AE53935"
                        app:strokeColor="@color/ra_light_border"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/ra_red"
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Card Informativa de Privacidad y Ayuda (Chunking) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/ra_light_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ra_light_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rec_paso2_info_titulo"
                        android:textColor="@color/ra_light_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Punto 1: Privacidad de cuenta asociada (Anti-enumeración) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_info_icon_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mail_outline"
                                app:tint="@color/ra_red" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rec_paso2_info1_titulo"
                                android:textColor="@color/ra_light_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingMultiplier="1.3"
                                android:text="@string/rec_paso2_info1_desc"
                                android:textColor="@color/ra_light_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/ra_light_divider" />

                    <!-- Punto 2: Revisar escritura o carpeta de Spam -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_info_icon_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_warning"
                                app:tint="@color/ra_red" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rec_paso2_info2_titulo"
                                android:textColor="@color/ra_light_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingMultiplier="1.3"
                                android:text="@string/rec_paso2_info2_desc"
                                android:textColor="@color/ra_light_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
