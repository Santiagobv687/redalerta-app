<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para cancelar el direccionamiento de una alerta con justificación (estilo RedAlerta) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ra_light_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Icono decorativo en círculo tintado -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_info_icon_circle"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/ra_red" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTituloCancelarDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/cancelar_dir_dialog_titulo"
            android:textColor="@color/ra_light_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMensajeCancelarDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/cancelar_dir_dialog_mensaje"
            android:textColor="@color/ra_light_text_secondary"
            android:textSize="14sp" />

        <!-- Campo de motivo estilizado con InputLight -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMotivoCancelacion"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/cancelar_dir_dialog_hint_motivo"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:errorIconDrawable="@drawable/ic_warning">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMotivoCancelacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Acción principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarCancelacionDir"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancelar_dir_dialog_confirmar"
            android:textColor="@color/ra_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ra_red"
            app:cornerRadius="26dp" />

        <!-- Acción secundaria -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverCancelacionDir"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancelar_dir_dialog_volver"
            android:textColor="@color/ra_light_text"
            android:textSize="15sp"
            app:cornerRadius="26dp"
            app:strokeColor="@color/ra_light_border" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
