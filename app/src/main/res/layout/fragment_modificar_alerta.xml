<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutModificarAlerta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.alert.ModificarAlertaFragment">

    <!-- BARRA SUPERIOR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutModificarAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarModificarAlerta"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ra_topbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ra_white"
            app:title="Modificar Alerta Comunitaria"
            app:titleTextColor="@color/ra_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- FORMULARIO CON SCROLL Y ADAPTACIÓN AL TECLADO (adjustResize) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollModificarAlerta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:isScrollContainer="true"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Modifica la descripción, ubicación en el mapa o evidencias fotográficas de tu reporte antes de que sea verificado por el líder comunitario."
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="13sp" />

            <!-- 1. DESCRIPCIÓN DEL INCIDENTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/alerta_seccion_descripcion"
                android:textColor="@color/ra_light_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescripcion"
                style="@style/Widget.RedAlerta.InputLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/alerta_hint_descripcion"
                app:counterEnabled="true"
                app:counterMaxLength="1000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minLines="4"
                    android:padding="14dp"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. UBICACIÓN TERRITORIAL Y MAPA INTERACTIVO GPS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/alerta_seccion_ubicacion"
                android:textColor="@color/ra_light_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Card del Mapa Interactivo con Puntero Ajustable -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapaGps"
                style="@style/Widget.RedAlerta.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Cabecera del mapa + Botón Mi Ubicación GPS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="PUNTO EXACTO DEL INCIDENTE"
                                android:textColor="@color/ra_light_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoGeocoder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ubicación actual registrada en la alerta."
                                android:textColor="@color/ra_light_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUsarMiGps"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Mi GPS"
                            android:textColor="@color/ra_light_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_my_location"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/ra_red"
                            app:strokeColor="@color/ra_light_border" />
                    </LinearLayout>

                    <!-- Contenedor visual del Mapa (220dp) con puntero central -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ra_light_border"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:id="@+id/frameContenedorMapa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <org.osmdroid.views.MapView
                                android:id="@+id/mapViewUbicacion"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Sombra en el punto exacto de la coordenada central -->
                            <View
                                android:id="@+id/viewSombraPuntero"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_dot_red" />

                            <!-- Puntero central cuya punta señala el centro exacto del mapa -->
                            <ImageView
                                android:id="@+id/ivPunteroMapa"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="Puntero de ubicación del incidente"
                                android:src="@drawable/ic_map_pin"
                                android:translationY="-18dp" />

                            <!-- Capa sobre la vista previa: evita conflicto con el scroll y abre el selector al tocarla -->
                            <View
                                android:id="@+id/viewBloqueoMapa"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/mapa_selector_abrir_desc"
                                android:focusable="true" />

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Lectura de coordenadas WGS84 capturadas -->
                    <!-- Lectura de coordenadas WGS84 capturadas -->
                    <TextView
                        android:id="@+id/tvCoordenadasGps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/ra_light_label"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Lat: 4.533889, Lon: -75.681111 • Alt: 1483 m" />

                    <!-- Ubicación territorial detectada automáticamente por el mapa GPS -->
                    <TextView
                        android:id="@+id/tvUbicacionDetectada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/ra_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Municipio detectado: Armenia, Quindío" />

                    <!-- Botón explícito modo vista previa: "Seleccionar en el mapa" -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarEnMapa"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="48dp"
                        android:text="Seleccionar en el mapa"
                        android:textColor="@color/ra_red"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_location_on"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/ra_red"
                        app:rippleColor="#1AE53935"
                        app:strokeColor="@color/ra_red"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dirección Detallada / Punto de Referencia (Único campo editable de ubicación) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDireccionDetallada"
                style="@style/Widget.RedAlerta.InputLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/alerta_label_direccion_detallada"
                app:helperText="@string/alerta_helper_direccion"
                app:helperTextEnabled="true"
                app:startIconDrawable="@drawable/ic_location_on"
                app:startIconTint="@color/ra_red"
                app:counterEnabled="true"
                app:counterMaxLength="255">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDireccionDetallada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="255"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. EVIDENCIAS FOTOGRÁFICAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/alerta_seccion_evidencias"
                    android:textColor="@color/ra_light_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarFoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="+ Adjuntar Foto"
                    android:textColor="@color/ra_red"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/ra_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoSubidaFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Foto subida exitosamente."
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_evidencia_seleccionada" />

            <!-- 4. OPCIÓN DE ANONIMATO Y PRIVACIDAD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnonimo"
                style="@style/Widget.RedAlerta.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbAnonimo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alerta_label_anonimo"
                            android:textColor="@color/ra_light_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/alerta_desc_anonimo"
                            android:textColor="@color/ra_light_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. BOTONES DE ACCIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarModificacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="Guardar Cambios"
                android:textColor="@color/ra_btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ra_btn_primary_bg"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarModificacion"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Cancelar"
                android:textColor="@color/ra_light_text"
                android:textSize="15sp"
                app:cornerRadius="26dp"
                app:strokeColor="@color/ra_light_border" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
