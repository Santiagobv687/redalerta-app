<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo modal reutilizable para acciones de ROLE_ORGANIZACION (Iniciar Gestión, Resolver, Rechazar) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ra_light_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Icono decorativo en círculo tintado -->
        <FrameLayout
            android:id="@+id/flIconoDialogOrg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_info_icon_circle"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivIconoDialogOrg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_success"
                app:tint="@color/ra_red" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTituloDialogOrg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/ra_light_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Iniciar Atención Comunitaria" />

        <TextView
            android:id="@+id/tvSubtituloDialogOrg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/ra_light_text_secondary"
            android:textSize="14sp"
            tools:text="Registre las notas iniciales del desplazamiento o atención operativa en terreno." />

        <!-- Campo de texto con TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCampoDialogOrg"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:counterEnabled="true"
            app:counterMaxLength="500"
            app:errorIconDrawable="@drawable/ic_warning"
            tools:hint="Observación inicial o notas de desplazamiento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCampoDialogOrg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:maxLines="6"
                android:padding="14dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón de acción principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarDialogOrg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/ra_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ra_red"
            app:cornerRadius="26dp"
            tools:text="Confirmar e Iniciar Gestión" />

        <!-- Botón de acción secundaria -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarDialogOrg"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancelar"
            android:textColor="@color/ra_light_text"
            android:textSize="15sp"
            app:cornerRadius="26dp"
            app:strokeColor="@color/ra_light_border" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
