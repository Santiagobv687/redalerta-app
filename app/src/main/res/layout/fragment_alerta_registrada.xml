<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg"
    android:fillViewport="true"
    tools:context=".ui.alert.AlertaRegistradaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- Tarjeta de confirmación -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ra_light_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ra_light_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Círculo con Check -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_success_circle">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_success"
                        app:tint="@color/ra_red" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/alerta_registrada_titulo"
                    android:textColor="@color/ra_light_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/alerta_registrada_subtitulo"
                    android:textColor="@color/ra_light_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Tarjetas de detalles (Tipo, Prioridad, Ubicación) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- Tipo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/ra_light_bg"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alerta_registrada_tipo_label"
                            android:textColor="@color/ra_light_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvResumenTipo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ra_light_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Incendio" />
                    </LinearLayout>

                    <!-- Prioridad -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/ra_light_bg"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alerta_registrada_prioridad_label"
                            android:textColor="@color/ra_light_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvResumenPrioridad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ra_light_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Media" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ubicación (Fila completa) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:background="@color/ra_light_bg"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alerta_registrada_ubicacion_label"
                        android:textColor="@color/ra_light_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvResumenUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ra_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="cra 13, el cooperativo" />
                </LinearLayout>

                <!-- Botón Registrar otra alerta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarOtra"
                    style="@style/Widget.RedAlerta.Button.Next"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/alerta_registrada_btn" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>