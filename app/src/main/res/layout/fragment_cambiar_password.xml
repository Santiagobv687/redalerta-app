<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutCambiarPassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg"
    tools:context=".ui.alert.CambiarPasswordFragment">

    <!-- BARRA SUPERIOR CON RETROCESO -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutCambiarPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCambiarPassword"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ra_topbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ra_white"
            app:title="Cambiar Contraseña"
            app:titleTextColor="@color/ra_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- FORMULARIO DE SEGURIDAD -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Ingresa tu contraseña actual y define una clave nueva de acceso. La nueva contraseña debe tener mínimo 8 caracteres."
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

            <!-- Banner de Error Backend -->
            <TextView
                android:id="@+id/tvPasswordErrorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_status_pendiente"
                android:padding="12dp"
                android:textColor="@color/ra_status_pendiente_text"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="La contraseña actual ingresada es incorrecta."
                tools:visibility="visible" />

            <!-- Input Contraseña Actual -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPasswordActual"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CONTRASEÑA ACTUAL *"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/ra_light_text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Nueva Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPasswordNuevo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="NUEVA CONTRASEÑA (mín. 8 caracteres) *"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordNuevo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/ra_light_text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Confirmar Nueva Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmarPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="CONFIRMAR NUEVA CONTRASEÑA *"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/ra_light_text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- BOTONES DE ACCIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="Guardar cambios"
                android:textColor="@color/ra_btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ra_btn_primary_bg"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarPassword"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Cancelar"
                android:textColor="@color/ra_light_text"
                android:textSize="15sp"
                app:cornerRadius="26dp"
                app:strokeColor="@color/ra_light_border" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
