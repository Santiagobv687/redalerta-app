<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RedAlerta.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reg_paso3_titulo"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- ═══════════ CARACTERIZACIÓN SOCIAL (OpenAPI) ═══════════ -->
        <!-- FECHA NACIMIENTO -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reg_label_fecha_nacimiento" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaNacimiento"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_fecha_nacimiento"
            app:endIconDrawable="@drawable/ic_person"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GÉNERO (Fila independiente) -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etGenero"
            android:text="@string/reg_label_genero" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGenero"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- INTEGRANTES DEL HOGAR (Fila independiente a ancho completo) -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etIntegrantes"
            android:text="@string/reg_label_integrantes" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIntegrantes"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_integrantes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIntegrantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 1. PREGUNTA GESTACIÓN/LACTANCIA (Visibilidad condicional para género FEMENINO) -->
        <LinearLayout
            android:id="@+id/containerGestacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reg_sw_gestacion"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGestacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:checkedButton="@+id/rbGestacionNo">

                <RadioButton
                    android:id="@+id/rbGestacionSi"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/selector_radio_si_no"
                    android:buttonTint="@color/ra_red"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/reg_opcion_si"
                    android:textColor="@color/selector_radio_si_no_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <RadioButton
                    android:id="@+id/rbGestacionNo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/selector_radio_si_no"
                    android:buttonTint="@color/ra_red"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/reg_opcion_no"
                    android:textColor="@color/selector_radio_si_no_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RadioGroup>
        </LinearLayout>

        <!-- 2. PREGUNTA MENORES DE EDAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/reg_sw_menores"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMenores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbMenoresNo">

            <RadioButton
                android:id="@+id/rbMenoresSi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_si"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <RadioButton
                android:id="@+id/rbMenoresNo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_no"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCantidadMenores"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/reg_label_cant_menores"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCantidadMenores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:minHeight="48dp"
                android:text="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. PREGUNTA DISCAPACIDAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/reg_sw_discapacidad"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgDiscapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbDiscapacidadNo">

            <RadioButton
                android:id="@+id/rbDiscapacidadSi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_si"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <RadioButton
                android:id="@+id/rbDiscapacidadNo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_no"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecificacionDiscapacidad"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/reg_label_espec_discapacidad"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecificacionDiscapacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. PREGUNTA GRUPO ÉTNICO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/reg_sw_etnico"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgEtnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbEtnicoNo">

            <RadioButton
                android:id="@+id/rbEtnicoSi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_si"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <RadioButton
                android:id="@+id/rbEtnicoNo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/selector_radio_si_no"
                android:buttonTint="@color/ra_red"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reg_opcion_no"
                android:textColor="@color/selector_radio_si_no_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecificacionEtnico"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/reg_label_espec_etnico"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecificacionEtnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divisor + botones -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/ra_light_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.RedAlerta.Button.Prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_anterior" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                style="@style/Widget.RedAlerta.Button.Next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_siguiente" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>