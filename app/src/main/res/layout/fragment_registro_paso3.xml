<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RedAlerta.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reg_paso3_titulo"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- ═══════════ CARACTERIZACIÓN SOCIAL (OpenAPI) ═══════════ -->
        <!-- FECHA NACIMIENTO -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reg_label_fecha_nacimiento" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaNacimiento"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_fecha_nacimiento"
            app:endIconDrawable="@drawable/ic_person"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GÉNERO (Fila independiente) -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etGenero"
            android:text="@string/reg_label_genero" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGenero"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- INTEGRANTES DEL HOGAR (Fila independiente a ancho completo) -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etIntegrantes"
            android:text="@string/reg_label_integrantes" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIntegrantes"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_integrantes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIntegrantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SWITCH GESTACIÓN/LACTANCIA (Visibilidad condicional para género FEMENINO) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swGestacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reg_sw_gestacion"
            android:textColor="@color/ra_light_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- SWITCH MENORES -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swMenores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reg_sw_menores"
            android:textColor="@color/ra_light_text"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCantidadMenores"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_label_cant_menores"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCantidadMenores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SWITCH DISCAPACIDAD -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swDiscapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reg_sw_discapacidad"
            android:textColor="@color/ra_light_text"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecificacionDiscapacidad"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_label_espec_discapacidad"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecificacionDiscapacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SWITCH GRUPO ÉTNICO -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEtnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reg_sw_etnico"
            android:textColor="@color/ra_light_text"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecificacionEtnico"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_label_espec_etnico"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecificacionEtnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divisor + botones -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/ra_light_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.RedAlerta.Button.Prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_anterior" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                style="@style/Widget.RedAlerta.Button.Next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_siguiente" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>