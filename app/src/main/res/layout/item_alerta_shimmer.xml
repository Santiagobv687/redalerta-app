<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/ra_light_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/ra_light_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Esqueleto: Avatar/Chip Categoría, Badge Estado y Tiempo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <!-- Avatar / Icono circular de categoría -->
            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_shimmer_bone" />

            <!-- Chip de Categoría -->
            <View
                android:layout_width="96dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shimmer_bone" />

            <!-- Badge de Estado -->
            <View
                android:layout_width="110dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shimmer_bone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Tiempo transcurrido -->
            <View
                android:layout_width="64dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_bone" />
        </LinearLayout>

        <!-- Título y Descripción Esqueleto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp">

            <!-- Línea de Título -->
            <View
                android:layout_width="220dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_shimmer_bone" />

            <!-- Líneas de Descripción -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_bone" />

            <View
                android:layout_width="260dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shimmer_bone" />
        </LinearLayout>

        <!-- Ubicación Esqueleto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_shimmer_bone" />

            <View
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_bone" />
        </LinearLayout>

        <!-- Foto de Evidencia Esqueleto (200dp igual que item_alerta.xml) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_shimmer_bone" />

        <!-- Footer Esqueleto: Autor y Código -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ra_footer_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <View
                android:layout_width="140dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_shimmer_bone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="56dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_shimmer_bone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
