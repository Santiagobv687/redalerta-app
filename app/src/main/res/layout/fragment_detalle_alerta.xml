<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutDetalleAlerta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg"
    tools:context=".ui.alert.DetalleAlertaFragment">

    <!-- BARRA SUPERIOR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetalle"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ra_topbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ra_white"
            app:title="Detalle del Incidente"
            app:titleTextColor="@color/ra_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="240dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Estado de la Alerta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFechaAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ra_text_muted"
                    android:textSize="13sp"
                    tools:text="Hace 2 horas" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvEstadoBadgeDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_revision"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/ra_status_revision_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    app:drawableTint="@color/ra_status_revision_text"
                    tools:text="PENDIENTE DE REVISIÓN" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/ra_light_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Inundación severa" />

            <TextView
                android:id="@+id/tvDescripcionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                tools:text="Descripción larga del incidente..." />

            <!-- SECCIÓN DESTACADA: EVALUACIÓN DEL LÍDER COMUNITARIO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvaluacionLider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ra_summary_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ra_summary_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVALUACIÓN DEL LÍDER COMUNITARIO"
                        android:textColor="@color/ra_summary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiderRemitente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ra_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Remitido por: Carlos Ramírez (Líder)" />

                    <TextView
                        android:id="@+id/tvLiderCategoriaPrioridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ra_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Categoría: INCENDIO • Prioridad: ALTA" />

                    <TextView
                        android:id="@+id/tvLiderObservacionTecnica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ra_light_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="Observación técnica: Se requiere desplazamiento urgente de máquina extintora por cercanía a viviendas." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/ra_light_divider" />

            <!-- Ubicación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_on"
                    app:tint="@color/ra_red" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UBICACIÓN"
                        android:textColor="@color/ra_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUbicacionDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ra_light_text"
                        android:textSize="15sp"
                        tools:text="Armenia • Carrera 14 # 12-25" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/ra_light_divider" />

            <!-- Reportado por -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/ra_gray" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REPORTADO POR"
                        android:textColor="@color/ra_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAutorDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ra_light_text"
                        android:textSize="15sp"
                        tools:text="María Gómez" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/ra_light_divider" />

            <!-- Evidencia -->
            <TextView
                android:id="@+id/tvEvidenciasLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="EVIDENCIAS FOTOGRÁFICAS"
                android:textColor="@color/ra_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Carrusel de evidencias -->
            <HorizontalScrollView
                android:id="@+id/scrollEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutEvidencias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ACCIONES INFERIORES CONDICIONALES PARA LÍDER -->
    <LinearLayout
        android:id="@+id/layoutAccionesLider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="80dp"
        android:background="@color/ra_white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEvaluarDireccionar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Evaluar y Direccionar"
            android:textColor="@color/ra_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ra_red"
            app:cornerRadius="26dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModificarDireccionamiento"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Modificar Evaluación"
            android:textColor="@color/ra_light_text"
            android:textSize="15sp"
            app:cornerRadius="26dp"
            app:strokeColor="@color/ra_light_border"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarDireccionamiento"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar Direccionamiento"
            android:textColor="@color/ra_red"
            android:visibility="gone" />

    </LinearLayout>

    <!-- BANNER INFORMATIVO PARA ORGANIZACIÓN -->
    <LinearLayout
        android:id="@+id/layoutBannerOrganizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="80dp"
        android:background="@color/ra_summary_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_success"
            app:tint="@color/ra_summary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Caso asignado a su entidad para atención operativa"
            android:textColor="@color/ra_summary_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
