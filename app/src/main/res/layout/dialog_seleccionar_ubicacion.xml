<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg">

    <!-- Mapa a pantalla completa: todos los gestos van al mapa -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapViewSeleccion"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sombra en el punto exacto de la coordenada central -->
    <View
        android:id="@+id/viewSombraPunteroSeleccion"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_dot_red" />

    <!-- Puntero fijo al centro; su punta señala el centro exacto del mapa -->
    <ImageView
        android:id="@+id/ivPunteroSeleccion"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@string/mapa_selector_puntero_desc"
        android:src="@drawable/ic_map_pin"
        android:translationY="-22dp" />

    <!-- Barra superior -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSeleccionUbicacion"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@color/ra_topbar"
        android:elevation="4dp"
        app:navigationContentDescription="@string/mapa_selector_cerrar_desc"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/ra_white"
        app:title="@string/mapa_selector_titulo"
        app:titleTextColor="@color/ra_white" />

    <!-- Zona inferior: controles del mapa + tarjeta de confirmación (zona del pulgar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomMas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/mapa_selector_zoom_mas_desc"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/ra_light_card"
                app:fabCustomSize="48dp"
                app:maxImageSize="24dp"
                app:tint="@color/ra_light_text" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomMenos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/mapa_selector_zoom_menos_desc"
                android:src="@drawable/ic_remove"
                app:backgroundTint="@color/ra_light_card"
                app:fabCustomSize="48dp"
                app:maxImageSize="24dp"
                app:tint="@color/ra_light_text" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMiGpsSeleccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/mapa_selector_mi_gps_desc"
                android:src="@drawable/ic_my_location"
                app:backgroundTint="@color/ra_light_card"
                app:fabCustomSize="48dp"
                app:maxImageSize="24dp"
                app:tint="@color/ra_red" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mapa_selector_instruccion"
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDireccionSeleccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ra_light_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Municipio detectado: Armenia, Quindío" />

            <TextView
                android:id="@+id/tvCoordenadasSeleccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ra_light_label"
                android:textSize="12sp"
                tools:text="Lat: 4.533889, Lon: -75.681111" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarSeleccion"
                    style="@style/Widget.RedAlerta.Button.Prev"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxWidth="320dp"
                    android:minHeight="48dp"
                    android:text="@string/mapa_selector_cancelar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmarSeleccion"
                    style="@style/Widget.RedAlerta.Button.Next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.4"
                    android:minHeight="48dp"
                    android:text="@string/mapa_selector_confirmar" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
