<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerVisorImagen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000">

    <!-- Imagen Ampliada Completa -->
    <ImageView
        android:id="@+id/imgFotoGrande"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="Fotografía de evidencia ampliada"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_photo_library" />

    <!-- Progress bar mientras carga Glide -->
    <ProgressBar
        android:id="@+id/pbCargaImagen"
        style="?android:attr/progressBarStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ra_white" />

    <!-- Botón Cerrar ("X") -->
    <ImageButton
        android:id="@+id/btnCerrarVisor"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="Cerrar visor"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        app:tint="@color/ra_white" />

</FrameLayout>
