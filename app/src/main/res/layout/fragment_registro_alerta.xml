<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutReportarAlerta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ra_light_bg"
    tools:context=".ui.alert.RegistroAlertaFragment">

    <!-- BARRA SUPERIOR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutReportarAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarReportarAlerta"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ra_topbar"
            app:title="Reportar Alerta Comunitaria"
            app:titleTextColor="@color/ra_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- FORMULARIO CON SCROLL, ESPACIO INFERIOR PARA BOTTOM NAV Y ADAPTACIÓN AL TECLADO -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Describe los hechos del incidente. Tu reporte será revisado y clasificado por el líder o comité comunitario."
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/tvReportadoPor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ra_summary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Reportado por: María Gómez — 18/10/2026, 5:00 p.m." />

            <!-- 1. DESCRIPCIÓN DEL INCIDENTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="DESCRIPCIÓN DEL INCIDENTE *"
                android:textColor="@color/ra_light_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescripcion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Detalle lo sucedido (mínimo 10 caracteres) *"
                app:counterEnabled="true"
                app:counterMaxLength="1000"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minLines="4"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. UBICACIÓN TERRITORIAL (CATÁLOGO Dpto y Municipio + Dirección) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="UBICACIÓN Y TERRITORIO *"
                android:textColor="@color/ra_light_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Selector Departamento -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDepartamento"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DEPARTAMENTO *"
                app:endIconMode="dropdown_menu"
                app:errorEnabled="true">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etDepartamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selector Municipio -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMunicipio"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="MUNICIPIO / CIUDAD *"
                app:endIconMode="dropdown_menu"
                app:errorEnabled="true">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etMunicipio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dirección Detallada / Punto de Referencia -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDireccionDetallada"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="DIRECCIÓN DETALLADA O PUNTO DE REFERENCIA *"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDireccionDetallada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="200"
                    android:textColor="@color/ra_light_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. EVIDENCIAS FOTOGRÁFICAS (Carga S3, máx 5 fotos) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EVIDENCIAS FOTOGRÁFICAS (Máx. 5)"
                    android:textColor="@color/ra_light_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarFoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="+ Adjuntar Foto"
                    android:textColor="@color/ra_red"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/ra_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoSubidaFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Puedes adjuntar imágenes en formato JPEG, PNG o WebP."
                android:textColor="@color/ra_light_text_secondary"
                android:textSize="12sp" />

            <!-- Lista Horizontal de Miniaturas seleccionadas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_evidencia_seleccionada" />

            <!-- 4. CHECKBOX DE ANONIMATO -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbAnonimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="@color/ra_red"
                android:text="¿Publicar de forma anónima?"
                android:textColor="@color/ra_light_text"
                android:textSize="15sp"
                app:checkedIconVisible="true"
                app:checkedIconTint="@color/ra_white" />

            <!-- 5. BOTÓN PRINCIPAL PUBLICAR ALERTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarAlerta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="Publicar Alerta"
                android:textColor="@color/ra_btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ra_btn_primary_bg"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
