<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.RedAlerta.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reg_paso2_titulo"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Subtítulo explicativo con contexto territorial -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reg_paso2_subtitulo"
            android:textColor="@color/ra_light_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- Indicador de progreso durante la sincronización del catálogo OpenAPI -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ra_red"
            app:trackColor="@color/ra_light_border" />

        <!-- DEPARTAMENTO -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etDepartamento"
            android:text="@string/reg_label_departamento" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDepartamento"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_departamento"
            app:startIconDrawable="@drawable/ic_location_on"
            app:startIconTint="@color/ra_red"
            app:endIconTint="@color/ra_light_label"
            app:errorIconDrawable="@drawable/ic_warning"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etDepartamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="@color/ra_light_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MUNICIPIO / CIUDAD -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etMunicipio"
            android:text="@string/reg_label_municipio" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMunicipio"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_municipio"
            app:startIconDrawable="@drawable/ic_location_on"
            app:startIconTint="@color/ra_light_hint"
            app:endIconTint="@color/ra_light_label"
            app:errorIconDrawable="@drawable/ic_warning"
            app:helperText="@string/reg_helper_seleccione_depto"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etMunicipio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="@color/ra_light_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BARRIO -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etBarrio"
            android:text="@string/reg_label_barrio" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBarrio"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_barrio"
            app:errorIconDrawable="@drawable/ic_warning">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBarrio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="48dp"
                android:maxLines="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DIRECCIÓN DE RESIDENCIA -->
        <TextView style="@style/Widget.RedAlerta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/etDireccion"
            android:text="@string/reg_label_direccion" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDireccion"
            style="@style/Widget.RedAlerta.InputLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/reg_hint_direccion"
            app:errorIconDrawable="@drawable/ic_warning">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:minHeight="48dp"
                android:maxLines="1"
                android:textColor="@color/ra_light_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divisor + botones -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/ra_light_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.RedAlerta.Button.Prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_anterior" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                style="@style/Widget.RedAlerta.Button.Next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg_btn_siguiente" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>