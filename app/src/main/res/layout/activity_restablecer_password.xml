<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ra_light_bg"
    tools:context=".ui.auth.RestablecerPasswordActivity">

    <!-- ═══════════ TOP BAR institucional oscuro (56dp) ═══════════ -->
    <LinearLayout
        android:id="@+id/topBarRestablecer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ra_topbar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_alert_triangle"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/login_brand"
            android:textColor="@color/ra_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvCancelarRestablecer"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:insetTop="6dp"
            android:insetBottom="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/rec_paso3_topbar_cancelar"
            android:textColor="@color/ra_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#1FE53935"
            app:strokeColor="@color/ra_red"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_close"
            app:iconSize="16dp"
            app:iconPadding="6dp"
            app:iconTint="@color/ra_red"
            app:rippleColor="#33E53935" />
    </LinearLayout>

    <!-- ═══════════ Contenido scrollable ═══════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ESTADO 1: FORMULARIO DE NUEVA CONTRASEÑA                   -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutFormularioRestablecer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp"
                android:visibility="visible">

                <!-- Encabezado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rec_paso3_titulo"
                    android:textColor="@color/ra_light_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/rec_paso3_subtitulo"
                    android:textColor="@color/ra_light_text_secondary"
                    android:textSize="14sp" />

                <!-- Card Principal: Ingreso y confirmación de contraseña -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RedAlerta.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="@string/rec_paso3_card_titulo"
                            android:textColor="@color/ra_light_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Campo 1: Nueva Contraseña -->
                        <TextView
                            style="@style/Widget.RedAlerta.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:labelFor="@+id/etNuevaPassword"
                            android:text="@string/rec_paso3_label_nueva" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNuevaPassword"
                            style="@style/Widget.RedAlerta.InputLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/rec_paso3_hint_nueva"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/ra_light_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNuevaPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:imeOptions="actionNext"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:minHeight="48dp"
                                android:textColor="@color/ra_light_text"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Campo 2: Confirmar Nueva Contraseña -->
                        <TextView
                            style="@style/Widget.RedAlerta.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/etConfirmarPassword"
                            android:text="@string/rec_paso3_label_confirmar" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilConfirmarPassword"
                            style="@style/Widget.RedAlerta.InputLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/rec_paso3_hint_confirmar"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/ra_light_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etConfirmarPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:minHeight="48dp"
                                android:textColor="@color/ra_light_text"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Botón de acción primaria (52dp alto - Ley de Fitts) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActualizarPassword"
                            style="@style/Widget.RedAlerta.Button.Next"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:text="@string/rec_paso3_btn_actualizar" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/ra_red"
                            tools:visibility="visible" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Informativa: Guía práctica de seguridad (Chunking en 3 bloques) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/ra_light_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ra_light_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rec_paso3_info_titulo"
                            android:textColor="@color/ra_light_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Recomendación 1: Fácil de recordar, difícil de adivinar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:baselineAligned="false"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_info_icon_circle">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/ra_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rec_paso3_info1_titulo"
                                    android:textColor="@color/ra_light_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingMultiplier="1.3"
                                    android:text="@string/rec_paso3_info1_desc"
                                    android:textColor="@color/ra_light_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/ra_light_divider" />

                        <!-- Recomendación 2: Evite usar datos personales públicos -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_info_icon_circle">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_lock_outline"
                                    app:tint="@color/ra_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rec_paso3_info2_titulo"
                                    android:textColor="@color/ra_light_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingMultiplier="1.3"
                                    android:text="@string/rec_paso3_info2_desc"
                                    android:textColor="@color/ra_light_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/ra_light_divider" />

                        <!-- Recomendación 3: Autorización temporal de un solo uso -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_info_icon_circle">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_schedule"
                                    app:tint="@color/ra_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rec_paso3_info3_titulo"
                                    android:textColor="@color/ra_light_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingMultiplier="1.3"
                                    android:text="@string/rec_paso3_info3_desc"
                                    android:textColor="@color/ra_light_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ESTADO 2: PANTALLA DE FEEDBACK DE ÉXITO                    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutExitoRestablecer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="48dp"
                android:paddingBottom="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <!-- Círculo de confirmación exitosa -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_success_circle">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/rec_exito_titulo"
                        android:src="@drawable/ic_check_success" />
                </FrameLayout>

                <!-- Título de éxito -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="@string/rec_exito_titulo"
                    android:textColor="@color/ra_success_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/rec_exito_subtitulo"
                    android:textColor="@color/ra_light_text_secondary"
                    android:textSize="14sp" />

                <!-- Correo de la cuenta actualizada -->
                <TextView
                    android:id="@+id/tvCorreoActualizado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/ra_light_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="usuario@redalerta.gov.co" />

                <!-- Card de confirmación de seguridad -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/ra_success_card_bg"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ra_success_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rec_exito_card_titulo"
                            android:textColor="@color/ra_success_card_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/rec_exito_item1"
                            android:textColor="@color/ra_success_card_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/rec_exito_item2"
                            android:textColor="@color/ra_success_card_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/rec_exito_item3"
                            android:textColor="@color/ra_success_card_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón primario: Iniciar sesión -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrLoginExito"
                    style="@style/Widget.RedAlerta.Button.Next"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/rec_exito_btn_login" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
