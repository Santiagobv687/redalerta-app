<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    app:cardBackgroundColor="@color/ra_light_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/ra_light_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: Remitente (Líder) + Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_person"
                app:tint="@color/ra_summary_text"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvRemitenteLider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="@color/ra_summary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Remitido por: Carlos Ramírez (Líder)" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ra_text_muted"
                android:textSize="12sp"
                tools:text="18 oct, 5:00 pm" />
        </LinearLayout>

        <!-- Fila 2: Chips de Categoría y Prioridad Sobrios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoriaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_revision"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/ra_status_revision_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="INCENDIO" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Chip Prioridad con borde y texto temático -->
            <TextView
                android:id="@+id/tvPrioridadChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PRIORIDAD: ALTA" />
        </LinearLayout>

        <!-- Fila 3: Descripción sintetizada -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ra_light_text"
            android:textSize="14sp"
            tools:text="Se requiere atención inmediata por posible conato de incendio en estructura." />

        <!-- Fila 4: Ubicación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_location_on"
                app:tint="@color/ra_red"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ra_light_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Armenia • Carrera 14 # 12-25" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
