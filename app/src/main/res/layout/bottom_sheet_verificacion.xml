<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/ra_light_card">

    <!-- Header del bottom sheet -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/bsId" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/ra_text_muted" />
        <ImageView android:id="@+id/btnCerrar" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="@color/ra_text_muted"/>
    </LinearLayout>

    <TextView android:id="@+id/bsTitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ra_light_text" />

    <!-- Prioridad y Estado -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <View android:id="@+id/bsDotPrioridad" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/bsPrioridad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/bsEstado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/ra_border_light"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESCRIPCIÓN" style="@style/Widget.RedAlerta.Label"/>
    <TextView android:id="@+id/bsDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/ra_light_text"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UBICACIÓN" style="@style/Widget.RedAlerta.Label" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/bsUbicacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/ra_light_text"/>

    <!-- Fila: Reportante y Fecha -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REPORTERO" style="@style/Widget.RedAlerta.Label"/>
            <TextView android:id="@+id/bsReportante" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FECHA / HORA" style="@style/Widget.RedAlerta.Label"/>
            <TextView android:id="@+id/bsFecha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/ra_border_light"/>

    <!-- Dropdown y Botón -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAMBIAR ESTADO A..." style="@style/Widget.RedAlerta.Label"/>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.RedAlerta.InputLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:endIconMode="dropdown_menu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdownEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAceptar"
        style="@style/Widget.RedAlerta.Button.Next"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/verif_aceptar" />
</LinearLayout>