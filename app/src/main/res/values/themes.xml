<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ Estilo base vacío para herencia implícita ═══ -->
    <style name="Widget.RedAlerta" parent="" />
    <!-- Tema principal dark, sin ActionBar -->
    <style name="Theme.RedAlerta" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ra_red</item>
        <item name="colorOnPrimary">@color/ra_white</item>
        <item name="colorSecondary">@color/ra_red</item>
        <item name="android:colorBackground">@color/ra_bg</item>
        <item name="colorSurface">@color/ra_bg_input</item>
        <item name="colorOnSurface">@color/ra_white</item>
        <item name="android:statusBarColor">@color/ra_bg</item>
        <item name="android:navigationBarColor">@color/ra_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="isLightTheme">false</item>
    </style>

    <!-- Estilo de TextInputLayout para RedAlerta -->
    <style name="Widget.RedAlerta.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ra_border_input</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/ra_gray_light</item>
        <item name="android:textColorHint">@color/ra_gray_light</item>
        <item name="boxBackgroundColor">@color/ra_bg_input</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- Botón rojo principal -->
    <style name="Widget.RedAlerta.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ra_red</item>
        <item name="android:textColor">@color/ra_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Botón outlined (registrar) -->
    <style name="Widget.RedAlerta.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ra_border_input</item>
        <item name="android:textColor">@color/ra_white</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Card blanca para formularios -->
    <style name="Widget.RedAlerta.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ra_light_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/ra_light_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Label pequeño en mayúsculas -->
    <style name="Widget.RedAlerta.Label">
        <item name="android:textColor">@color/ra_light_label</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Input outlined claro -->
    <style name="Widget.RedAlerta.InputLight" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ra_light_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/ra_light_card</item>
        <item name="hintTextColor">@color/ra_light_label</item>
        <item name="android:textColorHint">@color/ra_light_hint</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="android:textColor">@color/ra_light_text</item>
        <item name="android:textColorHighlight">#33E53935</item>
    </style>

    <!-- Botón "Siguiente" rojo compacto -->
    <style name="Widget.RedAlerta.Button.Next" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ra_red</item>
        <item name="android:textColor">@color/ra_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Botón "Anterior" outlined claro -->
    <style name="Widget.RedAlerta.Button.Prev" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ra_light_border</item>
        <item name="android:textColor">@color/ra_light_text</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Chip de rol (no seleccionado) -->
    <style name="Widget.RedAlerta.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ra_light_border</item>
        <item name="android:textColor">@color/ra_light_text</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="EmergencyCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_emergency_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="EmergencyIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <style name="EmergencyText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ra_light_text</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- ══════════════════════════════════════════════════ -->
    <!-- Tema light para pantallas post-login (MainActivity) -->
    <!-- ══════════════════════════════════════════════════ -->
    <style name="Theme.RedAlerta.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ra_red</item>
        <item name="colorOnPrimary">@color/ra_white</item>
        <item name="colorSecondary">@color/ra_red</item>
        <item name="android:colorBackground">@color/ra_light_bg</item>
        <item name="colorSurface">@color/ra_light_card</item>
        <item name="colorOnSurface">@color/ra_light_text</item>
        <item name="colorOnBackground">@color/ra_light_text</item>
        <item name="android:textColorPrimary">@color/ra_light_text</item>
        <item name="android:textColorSecondary">@color/ra_light_text_secondary</item>
        <item name="android:statusBarColor">@color/ra_topbar</item>
        <item name="android:navigationBarColor">@color/ra_light_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- ═══ Estilos para Verificación (Admin) ═══ -->
    <style name="StatCard">
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_stat_card</item>
        <item name="android:layout_marginEnd">8dp</item> <!-- Margen derecho -->
    </style>

    <style name="StatNumber">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ra_text_muted</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="FilterChip">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
</resources>